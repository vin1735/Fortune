.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Real organizational data must never be committed. Only the synthetic
# sample dataset (generated by scripts/generate_sample_data.py) is tracked.
data/*.csv
!data/chequing.csv
!data/savings.csv

# Figures regenerated from real data must never be committed either.
# Figures derived from the synthetic sample live in docs/sample_figures/
# instead, which is not covered by this rule.
outputs/*.png

# Real assumption values (rent, account numbers, confirmed transactions,
# liquid holdings) for local use against real data — see config.load_overrides
# and local_config.example.json. Never commit the real version of this file.
local_config.json
local_config.local.json
